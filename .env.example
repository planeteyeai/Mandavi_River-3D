# Optional — Vite bakes these in at build time (Vercel Project → Settings → Environment Variables).
# Leave unset to call Railway APIs directly from the browser (needs CORS).
# Prefer the proxy values below on Vercel so CORS is not required.

# Same-origin proxies (see vercel.json rewrites)
VITE_JALNETRA_API_BASE=/jalnetra-api
VITE_RIVEREYE_API=/rivereye-api

# Optional overrides
# VITE_BOD_COD_VIEWER_ID=
# VITE_RIVEREYE_ASSET_BASE=
# VITE_ANALYTICS_API_BASE=
