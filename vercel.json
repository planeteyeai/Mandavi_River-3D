{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/rivereye-api/:path*",
      "destination": "https://rivereye-production.up.railway.app/api/:path*"
    },
    {
      "source": "/jalnetra-api/:path*",
      "destination": "https://jalnetra-software-production.up.railway.app/:path*"
    },
    {
      "source": "/osm-overpass",
      "destination": "https://overpass-api.de/api/interpreter"
    },
    {
      "source": "/osm-overpass-2",
      "destination": "https://overpass.kumi.systems/api/interpreter"
    },
    {
      "source": "/osm-overpass-3",
      "destination": "https://overpass.openstreetmap.fr/api/interpreter"
    },
    {
      "source": "/((?!assets/|data/|rivereye-api|jalnetra-api|osm-overpass).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/:path*\\.(glb|gltf|bin)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "model/gltf-binary" }
      ]
    },
    {
      "source": "/:path*\\.dae",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/:path*\\.(kml|kmz|geojson|tif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ],
  "github": {
    "silent": true
  }
}
